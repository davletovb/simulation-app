{
  "schema_version": 1,
  "label": "How a real GOV.UK headline becomes a change in support. These rules are the whole mapping. The headline's title is lower-cased and compared with the phrases below; the first rule with a phrase in it decides. A headline that matches no rule is shown and changes nothing. Two rules are trade-offs: they help some groups and hurt others in the same story.",
  "source": {
    "name": "GOV.UK, Department for Education news",
    "feed_url": "https://www.gov.uk/search/news-and-communications.atom?organisations%5B%5D=department-for-education&order=updated-newest",
    "allowed_link_prefix": "https://www.gov.uk/",
    "licence": "Open Government Licence v3.0"
  },
  "max_items": 4,
  "max_with_effect": 2,
  "rules": [
    {
      "id": "funding_shift_mixed",
      "label": "Money moves between city and country schools",
      "tone": "bad",
      "any": [
        "funding formula",
        "funding reform",
        "fairer funding",
        "funding redistribution",
        "redistribute funding"
      ],
      "exposure_pct": {
        "urban": 40
      },
      "winners_ppm": {
        "rural": 20000
      }
    },
    {
      "id": "small_schools_mixed",
      "label": "Small rural schools merged or closed",
      "tone": "bad",
      "any": [
        "small schools",
        "school mergers",
        "merge schools",
        "merged schools",
        "rural school closures",
        "rural school closure"
      ],
      "exposure_pct": {
        "rural_low": 70,
        "rural_middle": 70,
        "rural_high": 40
      },
      "winners_ppm": {
        "urban_middle": 8000,
        "urban_high": 12000
      }
    },
    {
      "id": "teacher_pay_good",
      "label": "Teacher pay and recruitment improve",
      "tone": "good",
      "any": [
        "teacher pay award",
        "pay award",
        "pay rise for teachers",
        "teacher training places",
        "teacher recruitment boost",
        "recruitment boost",
        "more teachers",
        "new teachers",
        "teacher recruitment up",
        "teacher retention boost"
      ],
      "gain_ppm": {
        "everyone": 12000
      }
    },
    {
      "id": "school_buildings_good",
      "label": "School buildings improve",
      "tone": "good",
      "any": [
        "school rebuilding",
        "rebuilding programme",
        "new school buildings",
        "condition improvement",
        "repair funding",
        "schools rebuilt",
        "upgraded classrooms",
        "new schools",
        "school building programme"
      ],
      "gain_ppm": {
        "urban": 10000,
        "rural": 20000
      }
    },
    {
      "id": "attendance_good",
      "label": "Attendance and support for families improve",
      "tone": "good",
      "any": [
        "attendance improves",
        "attendance up",
        "attendance rises",
        "absence falls",
        "absence down",
        "breakfast clubs",
        "free school meals",
        "free breakfast"
