{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicRoleView",
  "description": "Server-only public response. Fields are private and no Deserialize exists:\nonly checked TryFrom<&RoleObservation> can construct serializable data.",
  "type": "object",
  "properties": {
    "allocation": {
      "$ref": "#/$defs/Allocation"
    },
    "available_credits": {
      "type": "integer",
      "format": "uint16",
      "maximum": 100,
      "minimum": 0
    },
    "belief_ppm": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1000000,
      "minimum": 0
    },
    "campaign_id": {
      "type": "string"
    },
    "meeting_id": {
      "type": "string"
    },
    "ministry": {
      "$ref": "#/$defs/Ministry"
    },
    "owned_commitments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PublicCommitment"
      }
    },
    "proposal_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "quarter": {
      "type": "integer",
      "format": "uint8",
      "maximum": 6,
      "minimum": 1
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "visible_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "campaign_id",
    "meeting_id",
    "proposal_version",
    "ministry",
    "quarter",
    "allocation",
    "available_credits",
    "belief_ppm",
    "owned_commitments",
    "visible_evidence_ids"
  ],
  "$defs": {
    "Allocation": {
      "type": "object",
      "properties": {
        "access": {
          "type": "integer",
          "format": "uint16",
          "maximum": 100,
          "minimum": 0
        },
        "repairs": {
          "type": "integer",
          "format": "uint16",
          "maximum": 100,
          "minimum": 0
        },
        "staff": {
          "type": "integer",
          "format": "uint16",
          "maximum": 100,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "staff",
        "repairs",
        "access"
      ]
    },
    "Ministry": {
      "type": "string",
      "enum": [
        "finance",
        "education",
        "infrastructure"
      ]
    },
    "PublicCommitment": {
      "type": "object",
      "properties": {
        "beneficiary": {
          "$ref": "#/$defs/Ministry"
        },
        "deadline_quarter": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1
        },
        "funded_units": {
          "type": "integer",
          "format": "uint16",
          "maximum": 100,
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "issuer": {
          "$ref": "#/$defs/Ministry"
        },
        "kind": {
          "type": "string"
        },
        "proposal_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "resolution_event": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "issuer",
        "beneficiary",
        "proposal_version",
        "kind",
        "funded_units",
        "trigger",
        "deadline_quarter",
        "status"
      ]
    }
  }
}
