{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommandEnvelope",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "command": {
      "$ref": "#/$defs/PlayerAction"
    },
    "command_id": {
      "type": "string"
    },
    "expected_world_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "command_id",
    "expected_world_version",
    "command"
  ],
  "$defs": {
    "Allocation": {
      "type": "object",
      "properties": {
        "access": {
          "type": "integer",
          "format": "uint16",
          "maximum": 100,
          "minimum": 0
        },
        "repairs": {
          "type": "integer",
          "format": "uint16",
          "maximum": 100,
          "minimum": 0
        },
        "staff": {
          "type": "integer",
          "format": "uint16",
          "maximum": 100,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "staff",
        "repairs",
        "access"
      ]
    },
    "CapacityCaps": {
      "type": "object",
      "properties": {
        "access": {
          "type": "integer",
          "format": "uint16",
          "maximum": 4,
          "minimum": 0
        },
        "repairs": {
          "type": "integer",
          "format": "uint16",
          "maximum": 10,
          "minimum": 0
        },
        "staff": {
          "type": "integer",
          "format": "uint16",
          "maximum": 12,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "staff",
        "repairs",
        "access"
      ]
    },
    "Family": {
      "type": "string",
      "enum": [
        "staffing",
        "repairs",
        "access"
      ]
    },
    "Ministry": {
      "type": "string",
      "enum": [
        "finance",
        "education",
        "infrastructure"
      ]
    },
    "PlayerAction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "allocation": {
              "$ref": "#/$defs/Allocation"
            },
            "kind": {
              "type": "string",
              "const": "propose"
            },
            "meeting_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "meeting_id",
            "allocation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "allocation": {
              "$ref": "#/$defs/Allocation"
            },
            "kind": {
              "type": "string",
              "const": "amend"
            },
            "meeting_id": {
              "type": "string"
            },
            "proposal_version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "meeting_id",
            "proposal_version",
            "allocation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ratify"
            },
            "meeting_id": {
              "type": "string"
            },
            "proposal_version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "meeting_id",
            "proposal_version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "caps": {
              "$ref": "#/$defs/CapacityCaps"
            },
            "kind": {
              "type": "string",
              "const": "request_capacity_cap"
            },
            "meeting_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "meeting_id",
            "caps"
          ]
        },
        {
          "type": "object",
          "properties": {
            "family": {
              "$ref": "#/$defs/Family"
            },
            "inspected_quarter": {
              "type": "integer",
              "format": "uint8",
              "maximum": 60,
              "minimum": 1
            },
            "kind": {
              "type": "string",
              "const": "order_audit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "family",
            "inspected_quarter"
          ]
        },
        {
          "type": "object",
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "evidence_version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "kind": {
              "type": "string",
              "const": "disclose_evidence"
            },
            "recipients": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Ministry"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "evidence_id",
            "evidence_version",
            "recipients"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "defer"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "advance_quarter"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Begin the next term after winning the election that ended the last one.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "begin_term"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Pay to soften an announced bad headline that lands in `headline_quarter` (decision 0010).",
          "type": "object",
          "properties": {
            "headline_quarter": {
              "type": "integer",
              "format": "uint8",
              "maximum": 60,
              "minimum": 2
            },
            "kind": {
              "type": "string",
              "const": "respond"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "headline_quarter"
          ]
        },
        {
          "description": "Freeze the real headlines fetched for this term into the record (decision 0013). Issued by the server, never the browser.",
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RealItemWire"
              },
              "maxItems": 4,
              "minItems": 1
            },
            "kind": {
              "type": "string",
              "const": "import_news"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "items"
          ]
        }
      ]
    },
    "RealItemWire": {
      "description": "A real headline: its words and link, and the rule that matched it, if any.",
      "type": "object",
      "properties": {
        "published": {
          "description": "`YYYY-MM-DD`.",
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/RealRuleWire"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "summary",
        "url",
        "published"
      ]
    },
    "RealRuleWire": {
      "description": "The rule that turned a real headline into numbers (decision 0013).",
      "type": "object",
      "properties": {
        "effect": {
          "description": "Bad news: each group's exposure in percent of the worst case. Good news: each group's gain in ppm.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "maxItems": 6,
          "minItems": 6
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "tone": {
          "$ref": "#/$defs/RealToneWire"
        },
        "winners": {
          "description": "Bad news that is also a trade-off: the groups it helps, a flat gain in ppm (decision 0014). All zero otherwise.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "maxItems": 6,
          "minItems": 6
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "tone",
        "effect",
        "winners"
      ]
    },
    "RealToneWire": {
      "description": "Whether a real headline is good or bad news.",
      "type": "string",
      "enum": [
        "bad",
        "good"
      ]
    }
  }
}
